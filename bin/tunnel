#!/usr/bin/env bash
# Open or close a Cloudflare quick tunnel from a shell, through the local Porthole API, so it shows up
# on the phone. Usage:
#   tunnel 8008 [label]     open a tunnel to local port 8008
#   tunnel ls               list open tunnels
#   tunnel rm 8008          close it
set -euo pipefail

PORT_API="${PORTHOLE_PORT:-7331}"
STATE="${PORTHOLE_STATE:-$HOME/.porthole}"
BASE="http://127.0.0.1:${PORT_API}"
JAR=$(mktemp); trap 'rm -f "$JAR"' EXIT

token() { [ -n "${PORTHOLE_TOKEN:-}" ] && echo "$PORTHOLE_TOKEN" || cat "$STATE/token"; }

login() {
    curl -fsS -c "$JAR" -H 'Content-Type: application/json' -H 'X-Porthole: 1' \
        -d "{\"token\":\"$(token)\"}" "$BASE/api/login/token" >/dev/null
}

case "${1:-}" in
    ""|-h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    ls)
        login
        curl -fsS -b "$JAR" "$BASE/api/tunnels" | jq -r '.tunnels[] | "\(.port)\t\(.url // "pending")\t\(.name)"'
        ;;
    rm)
        login
        curl -fsS -b "$JAR" -H 'X-Porthole: 1' -X DELETE "$BASE/api/tunnels/${2:?port}" >/dev/null && echo "closed tunnel on port $2"
        ;;
    *)
        PORT="$1"; LABEL="${2:-}"
        login
        OUT=$(curl -fsS -b "$JAR" -H 'Content-Type: application/json' -H 'X-Porthole: 1' \
            -d "$(jq -cn --argjson p "$PORT" --arg n "$LABEL" '{port:$p,name:$n}')" "$BASE/api/tunnels")
        URL=$(echo "$OUT" | jq -r '.url // empty')
        if [ -n "$URL" ]; then echo "$URL"; else echo "tunnel starting; check the Tunnels tab or run: tunnel ls"; fi
        ;;
esac
