#!/usr/bin/env node
// plato-tool <app> [<tool> [--field value …] [--json '{…}']]: run one of an app's agent tools from a shell.
//   plato-tool jobs                      list the Job Hunt tools and their fields
//   plato-tool jobs show_job --id j1a2b3
//   plato-tool jobs save_match --json '{"id":"j1a2b3","score":72,"summary":"…","lines":[…]}'
// Repeat a field for a list (--tags a --tags b) or give it as JSON. Called as `jobs …` it is `plato-tool jobs …`.
import path from 'node:path';
const self = path.basename(process.argv[1]);
const argv = process.argv.slice(2); const APP = self === 'plato-tool' ? argv.shift() : self;
const die = (m, c = 1) => { console.error(m); process.exit(c); };
if (!APP) die('usage: plato-tool <app> [<tool> --field value …]');
const base = () => `http://127.0.0.1:${process.env.PLATO_PORT || process.env.PORTHOLE_PORT || '7331'}`;
let cookie = null;
async function call(p, method = 'GET', body) {
    const headers = { 'Content-Type': 'application/json', 'X-Plato': '1' };
    if (!cookie) {
        const token = process.env.PLATO_TOKEN || process.env.PORTHOLE_TOKEN || ''; if (!token) die('This shell has no PlatOpypus token (start it from the app as an agent shell).');
        const l = await fetch(`${base()}/api/login/token`, { method: 'POST', headers, body: JSON.stringify({ token }) }); if (!l.ok) die('PlatOpypus did not accept this shell\'s token.');
        cookie = (l.headers.get('set-cookie') || '').split(';')[0];
    }
    const r = await fetch(base() + p, { method, headers: { ...headers, cookie }, body: method === 'GET' ? undefined : JSON.stringify({ ...(body || {}), pid: process.pid }), signal: AbortSignal.timeout(16 * 60_000) });
    const d = await r.json().catch(() => ({})); if (!r.ok) die(d.error || `HTTP ${r.status}`, r.status === 403 ? 3 : 1); return d;
}
try {
    const { tools } = await call(`/api/agent/tools/${APP}`);
    const tool = argv.shift(); const shown = process.env.PLATO_TOOL_AS || (self === 'plato-tool' ? `plato-tool ${APP}` : APP);
    if (!tool || tool === '-h' || tool === '--help') {
        console.log(`${APP} tools (run: ${shown} <tool> --field value …):\n`);
        for (const t of tools) { const req = new Set(t.inputSchema.required || []); console.log(`  ${t.name}  ${Object.entries(t.inputSchema.properties || {}).map(([k, v]) => `${req.has(k) ? '' : '['}--${k} <${v.type}>${req.has(k) ? '' : ']'}`).join(' ')}\n      ${t.description}`); }
        process.exit(0);
    }
    const t = tools.find(x => x.name === tool); if (!t) die(`No tool "${tool}". Run: ${shown} --help`);
    const props = t.inputSchema.properties || {}; let args = {};
    for (let i = 0; i < argv.length; i++) {
        const a = argv[i];
        if (a === '--json') { args = { ...args, ...JSON.parse(argv[++i] || '{}') }; continue; }
        if (!a.startsWith('--')) die(`Unexpected "${a}": give fields as --name value.`);
        const k = a.slice(2); const p = props[k]; if (!p) die(`${tool} has no field "${k}". Fields: ${Object.keys(props).join(', ')}`);
        if (p.type === 'boolean') { args[k] = !(argv[i + 1] === 'false' && ++i); continue; }
        const v = argv[++i]; if (v === undefined) die(`--${k} needs a value.`);
        if (p.type === 'number') args[k] = Number(v);
        else if (p.type === 'array') { let parsed; try { parsed = JSON.parse(v); } catch { parsed = null; } args[k] = Array.isArray(parsed) ? parsed : [...(args[k] || []), v]; }
        else if (p.type === 'object') args[k] = JSON.parse(v);
        else args[k] = v;
    }
    const d = await call(`/api/agent/tools/${APP}/${encodeURIComponent(tool)}`, 'POST', { args });
    console.log(d.text);
} catch (e) { die(e.message); }
