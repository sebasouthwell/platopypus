#!/usr/bin/env bash
# PlatOpypus box CLI (`plato`, also `porthole`) — recovery and housekeeping, run on the box as the service user (root by default).
#
#   plato reset-auth    forget passkeys, password, two-step codes and all sessions; print a fresh setup token.
#                          The web app shows the first-run setup screen again. Vault, files, shells, containers untouched.
#   plato reset-totp    turn two-step codes off only (lost authenticator); passkey/password still required.
#   plato token         print the current setup/CLI token (only useful before first setup or after reset-auth).
#   plato sessions      sign every device out (credentials stay).
#   plato status        service, version, credential summary.
#   plato update        run the self-updater now (same as More → Update).
#   plato power            may the box be powered off now? JSON, and an exit code like a health check: 0 = yes,
#                          3 = no (an agent is working, or it is kept on). Read-only. For any scheduler or script.
#   plato power --check    the same, recorded in the audit log with an alert: for whatever is about to act on it.
#   plato activity      which agents are working right now (no side effects).
set -euo pipefail

STATE="${PLATO_STATE:-${PORTHOLE_STATE:-}}"; [ -n "$STATE" ] || { if [ -e "${HOME:-/root}/.platopypus" ] || [ ! -e "${HOME:-/root}/.porthole" ]; then STATE="${HOME:-/root}/.platopypus"; else STATE="${HOME:-/root}/.porthole"; fi; }
APP="${PLATO_APP:-${PORTHOLE_APP:-}}"; [ -n "$APP" ] || { if [ -e /opt/platopypus ] || [ ! -e /opt/porthole ]; then APP=/opt/platopypus; else APP=/opt/porthole; fi; }
unit() { if systemctl cat platopypus >/dev/null 2>&1; then echo platopypus; else echo porthole; fi; }
SEC="$STATE/security.json"

restart_service() {
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$(unit)" 2>/dev/null; then
        systemctl restart "$(unit)" && echo "$(unit) service restarted"
    else
        echo "restart the PlatOpypus server to apply (it reads the token at start)"
    fi
}

case "${1:-}" in
    reset-auth)
        rm -f "$SEC" "$STATE/auth-sessions.json"
        # (not `tr … | head`: under pipefail the SIGPIPE from head ended this script before the restart, 2.0.2 and earlier)
        node -e 'process.stdout.write(require("crypto").randomBytes(24).toString("base64url") + "\n")' > "$STATE/token"; chmod 600 "$STATE/token"
        echo "passkeys, password, two-step codes and sessions removed."
        echo "new setup token: $(cat "$STATE/token")"
        echo "open the site: it shows the setup screen; enter this token and create a passkey."
        restart_service
        ;;
    reset-totp)
        if [ -f "$SEC" ]; then
            node -e 'const fs=require("fs");const f=process.argv[1];const s=JSON.parse(fs.readFileSync(f,"utf8"));delete s.totp;delete s.pending;fs.writeFileSync(f,JSON.stringify(s,null,2));' "$SEC"
            echo "two-step codes removed; passkey or password still required."
        else
            echo "no security state yet (first run)."
        fi
        ;;
    token)
        cat "$STATE/token" 2>/dev/null || echo "no token file yet; start the server once (or run: plato reset-auth)"
        ;;
    sessions)
        rm -f "$STATE/auth-sessions.json"; echo "all devices signed out."; restart_service
        ;;
    status)
        echo "version:  $(node -e 'console.log(require(process.argv[1]).version)' "$APP/server/package.json" 2>/dev/null || echo '?') ($(cat "$APP/VERSION" 2>/dev/null | cut -d' ' -f1))"
        if command -v systemctl >/dev/null 2>&1; then echo "service:  $(systemctl is-active "$(unit)" 2>/dev/null || echo 'not installed') ($(unit))"; fi
        if [ -f "$SEC" ]; then
            node -e 'const s=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log(`passkeys: ${(s.passkeys||[]).length}  password: ${s.password?"set":"no"}  two-step: ${s.totp&&s.totp.enabled?"on":"off"}`)' "$SEC"
        else
            echo "credentials: none (setup screen will show)"
        fi
        echo "sessions: $(node -e 'try{console.log(Object.keys(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))).length)}catch{console.log(0)}' "$STATE/auth-sessions.json")"
        echo "state:    $STATE"
        ;;
    update)
        exec bash "$APP/bin/plato-update"
        ;;
    power|autostop-check|activity)
        # Sign in to the local server with the box token (loopback only), then ask.
        PORT="${PLATO_PORT:-${PORTHOLE_PORT:-7331}}"; JAR="$(mktemp)"; trap 'rm -f "$JAR"' EXIT
        TOK="${PLATO_TOKEN:-${PORTHOLE_TOKEN:-}}"; [ -n "$TOK" ] || TOK="$(cat "$STATE/token" 2>/dev/null)"
        [ -n "$TOK" ] || { echo '{"error":"no token"}'; exit 1; }
        curl -fsS -c "$JAR" -H 'Content-Type: application/json' -H 'X-Plato: 1' -d "{\"token\":\"$TOK\"}" "http://127.0.0.1:$PORT/api/login/token" >/dev/null || { echo '{"error":"sign-in failed"}'; exit 1; }
        if [ "$1" = activity ]; then curl -fsS -b "$JAR" -H 'X-Plato: 1' "http://127.0.0.1:$PORT/api/activity"
        elif [ "$1" = power ] && [ "${2:-}" != --check ]; then
            OUT="$(curl -fsS -m 60 -b "$JAR" -H 'X-Plato: 1' "http://127.0.0.1:$PORT/api/power")" || { echo '{"error":"no answer"}'; exit 1; }
            echo "$OUT"; case "$OUT" in *'"canPowerOff":true'*) exit 0 ;; *) exit 3 ;; esac
        else curl -fsS -m 60 -b "$JAR" -H 'X-Plato: 1' -H 'Content-Type: application/json' -X POST -d "{\"dry\":$([ "${2:-}" = --dry ] && echo true || echo false)}" "http://127.0.0.1:$PORT/api/power/check"; fi
        echo
        ;;
    *)
        sed -n '2,10p' "$0"
        ;;
esac
