#!/usr/bin/env node
// Read tokens from the Porthole vault from a shell (or from Claude Code running in one).
//   vault ls                 list what is available (never prints values)
//   vault get <ENV_NAME>     print one value (for command substitution: TOKEN=$(vault get SPOTIFY_SECRET)).
//                            Project credentials are only given out when the current folder IS that project's
//                            main folder (not a sub-folder); general ones work anywhere.
//   vault env [folder]       print `export NAME=value` lines for the general scope + the folder's project scope
//                            use as: eval "$(vault env)"
// Values are decrypted with the key in ~/.porthole/vault.key, which only this user can read.

import path from 'node:path';
import { pathToFileURL } from 'node:url';

// Agent-user shells cannot read the vault key: they ask Porthole, which checks the calling process and its folder.
if (process.env.PORTHOLE_RUN_AS === 'agent' || (process.getuid && process.getuid() !== 0)) {
    const [cmd, arg] = process.argv.slice(2);
    const port = process.env.PORTHOLE_PORT || '7331';
    const headers = { 'Content-Type': 'application/json', 'X-Porthole': '1' };
    const sq = s => `'${String(s).replace(/'/g, `'\''`)}'`;
    try {
        const login = await fetch(`http://127.0.0.1:${port}/api/login/token`, { method: 'POST', headers, body: JSON.stringify({ token: process.env.PORTHOLE_TOKEN || '' }), signal: AbortSignal.timeout(5000) });
        if (!login.ok) throw new Error('this shell has no Porthole token (start it as an agent-user shell)');
        const cookie = (login.headers.get('set-cookie') || '').split(';')[0];
        const call = async (p, method = 'GET', body) => { const r = await fetch(`http://127.0.0.1:${port}${p}`, { method, headers: { ...headers, cookie }, body: body && JSON.stringify(body), signal: AbortSignal.timeout(15000) }); const d = await r.json().catch(() => ({})); if (!r.ok) { console.error(d.error || `HTTP ${r.status}`); process.exit(1); } return d; };
        if (cmd === 'ls') { for (const i of await call('/api/vault')) for (const f of i.fields) console.log(`${f.env.padEnd(28)}  ${i.provider.padEnd(16)}  ${i.scope === 'general' ? 'general' : 'project:' + i.scope}  ${i.name}`); }
        else if (cmd === 'get') { if (!arg) { console.error('usage: vault get <ENV_NAME>'); process.exit(2); } process.stdout.write(String((await call('/api/agent/vault', 'POST', { name: arg, pid: process.pid })).value)); }
        else if (cmd === 'env') { for (const [k, v] of Object.entries((await call('/api/agent/vault', 'POST', { pid: process.pid })).env)) console.log(`export ${k}=${sq(v)}`); }
        else { console.log('usage: vault ls | vault get <ENV_NAME> | vault env'); process.exit(cmd ? 2 : 0); }
    } catch (e) { console.error(`vault: ${e.message}`); process.exit(1); }
    process.exit(0);
}

process.env.PORTHOLE_STATE ||= path.join(process.env.HOME || '/root', '.porthole');
const lib = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..', 'server', 'lib');
const vault = await import(pathToFileURL(path.join(lib, 'vault.js')).href);
const { config } = await import(pathToFileURL(path.join(lib, 'config.js')).href);

const [cmd, arg] = process.argv.slice(2);

function sq(s) { return `'${String(s).replace(/'/g, `'\\''`)}'`; }

switch (cmd) {
    case 'ls': {
        const items = vault.list();
        if (!items.length) { console.log('vault is empty — add credentials from the Vault tab in Porthole'); break; }
        const rows = items.flatMap(i => i.fields.map(f => [f.env, i.provider, i.style, i.scope === 'general' ? 'general' : 'project:' + i.scope, i.name + (i.oauth ? (i.oauth.connected ? ' (connected)' : ' (not connected)') : '')]));
        const w = Math.max(...rows.map(r => r[0].length));
        for (const r of rows) console.log(`${r[0].padEnd(w)}  ${r[1].padEnd(16)}  ${r[2].padEnd(9)}  ${r[3]}  ${r[4]}`);
        break;
    }
    case 'get': {
        if (!arg) { console.error('usage: vault get <ENV_NAME>'); process.exit(2); }
        const cwd = process.cwd();
        const env = await vault.envFor(cwd);
        if (!(arg in env)) {
            const all = vault.list().find(i => i.fields.some(f => f.env === arg));
            console.error(all ? `${arg} belongs to project ${all.scope}; run vault get from that project's main folder (/${all.scope}), not elsewhere or a sub-folder` : `no variable named ${arg} (try: vault ls)`);
            process.exit(1);
        }
        process.stdout.write(env[arg]);
        break;
    }
    case 'env': {
        const dir = arg ? path.resolve(config.root, arg) : process.cwd();
        for (const [k, v] of Object.entries(await vault.envFor(dir))) console.log(`export ${k}=${sq(v)}`);
        break;
    }
    default:
        console.log('usage: vault ls | vault get <ENV_NAME> | vault env [folder]');
        process.exit(cmd ? 2 : 0);
}
